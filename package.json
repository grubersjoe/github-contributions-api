{
  "name": "github-contribution-api",
  "description": "Scrape contribution data of a Github user",
  "version": "4.13.0",
  "author": "Jonathan Gruber <gruberjonathan@gmail.com>",
  "license": "MIT",
  "private": true,
  "main": "build/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf build/* && tsc -p tsconfig.build.json",
    "check": "pnpm install --frozen-lockfile --ignore-scripts && prettier -c . && pnpm typecheck && pnpm lint && pnpm test",
    "dev": "nodemon src/server.ts --exec ts-node src/server.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "postinstall": "npm run build",
    "prepare": "husky",
    "prestart": "npm run build",
    "start": "node build/server.js",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grubersjoe/github-contributions-api.git"
  },
  "bugs": {
    "url": "git+https://github.com/grubersjoe/github-contributions-api.git"
  },
  "keywords": [
    "github",
    "contributions",
    "calendar",
    "node"
  ],
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.5",
    "@sentry/node": "^10.70.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "domhandler": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "json-stable-stringify": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/bases": "^1.0.27",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "prettier": {
    "proseWrap": "always",
    "semi": false,
    "singleQuote": true
  }
}
