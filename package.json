{
  "name": "github-contribution-api",
  "description": "Scrape contribution data of a Github user",
  "version": "4.13.2",
  "author": "Jonathan Gruber <gruberjonathan@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "build/server.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf build/* && tsc -p tsconfig.build.json",
    "check": "pnpm install --frozen-lockfile --ignore-scripts && prettier -c . && pnpm typecheck && pnpm lint && pnpm test",
    "dev": "node --watch --import ./src/instrument.ts src/server.ts",
    "format": "prettier --write .",
    "lint": "oxlint",
    "postinstall": "npm run build",
    "prepare": "husky",
    "prestart": "npm run build",
    "start": "node --import ./build/instrument.js build/server.js",
    "test": "vitest run",
    "test:github": "vitest run --config vitest.github.config.mts",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grubersjoe/github-contributions-api.git"
  },
  "bugs": {
    "url": "git+https://github.com/grubersjoe/github-contributions-api.git"
  },
  "keywords": [
    "github",
    "contributions",
    "calendar",
    "node"
  ],
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.5",
    "@sentry/node": "^11.12.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "domhandler": "^6.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "json-stable-stringify": "^1.3.0",
    "undici": "^7.30.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tsconfig/bases": "^1.0.30",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "date-fns": "^4.4.0",
    "husky": "^9.1.7",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "prettier": {
    "proseWrap": "always",
    "quoteProps": "consistent",
    "semi": false,
    "singleQuote": true
  }
}
